# Copy this file to ".env" and fill in your real values.
# .env is git-ignored, so your key stays on your machine.
# Which LLM runs Rin: "openai" (default) or "anthropic".
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=<model name from OpenAI's docs>

# Anthropic (used when LLM_PROVIDER=anthropic). Key from https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-5-5   # default if unset; claude-sonnet-5-5 / claude-haiku-5-5 cost less

# Optional: require a login for the web app (recommended once it's deployed publicly).
# Leave unset locally to skip the login screen.
# APP_USERNAME=ash
# APP_PASSWORD=choose-a-strong-password

# Supabase (trainer journal). Without these, the app runs but can't log events.
# Project Settings -> API. Use the service_role / secret key: it stays on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Knowledge notes (RAG). All optional - these are the defaults.
# Embeddings always use OpenAI (OPENAI_API_KEY), even when LLM_PROVIDER=anthropic.
# RAG_BUCKET=RAG Files
# RAG_FILES=rin_pokemmo_notes.md          # comma-separated for several files
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1024               # must match doc_chunks.embedding vector(1024)

